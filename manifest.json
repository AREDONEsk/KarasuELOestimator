{
  "manifest_version": 3,
  "name": "Karasu ELO Estimator",
  "version": "1.7.7",
  "description": "Unofficial. Win chance and estimated Elo gain/loss for both teams on karasu.live, plus optional auto-accept.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://karasu.live/*"
      ],
      "js": [
        "model.js",
        "content.js",
        "accept.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Karasu ELO Estimator"
  }
}